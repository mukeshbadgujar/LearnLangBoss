# Copy this file to ".env" in the repo root and fill in what you have.
# Nothing here is committed - ".env" is git-ignored.
# You only need ONE chat provider key to start. Groq has a generous free tier.

# ============================================================
# 1. CHAT MODEL PROVIDERS (resolved in this order)
# ============================================================

# --- Priority 1: Groq (fast + free tier) -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Priority 2: OpenRouter (one key, many models) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Priority 3: OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional extra provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Force a provider for every notebook regardless of the order above.
# Valid values: groq | openrouter | openai | anthropic
LLM_PROVIDER=

# Model that must support images (notebook 22). Groq/OpenRouter/OpenAI all have options.
VISION_MODEL=

# ============================================================
# 2. EMBEDDINGS
# ============================================================
# "auto" picks the first that works, cheapest first:
#   groq        -> free tier, 768 dims, no local install, reuses GROQ_API_KEY
#   huggingface -> local and offline, but needs torch (~2 GB install)
#   openai      -> paid, strongest quality baseline
#   fake        -> deterministic nonsense; notebooks run but scores are meaningless
# Pin one explicitly by replacing "auto" below.
EMBEDDING_PROVIDER=auto

GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq's free tier is rate limited. When indexing a large corpus, either pin
# EMBEDDING_PROVIDER=huggingface or embed in smaller batches.

# ============================================================
# 3. OBSERVABILITY (LangSmith) - optional but strongly recommended
# ============================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=genai-mastery
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# 4. OPTIONAL SERVICES (individual notebooks skip cleanly without these)
# ============================================================
TAVILY_API_KEY=            # web search for research agents
COHERE_API_KEY=            # reranking (notebook 15)
PINECONE_API_KEY=          # managed vector store (notebook 12)
PINECONE_INDEX=genai-mastery
POSTGRES_URI=              # PostgresSaver checkpointer (notebook 35)
REDIS_URL=                 # semantic cache (notebook 23)
